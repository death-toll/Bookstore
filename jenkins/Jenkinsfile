pipeline {
  agent any

  environment {
    // --- Azure ---
    AZ_TENANT_ID        = credentials('AZ_TENANT_ID')
    AZ_CLIENT_ID        = credentials('AZ_CLIENT_ID')
    AZ_CLIENT_SECRET    = credentials('AZ_CLIENT_SECRET')
    AZ_SUBSCRIPTION_ID  = credentials('AZ_SUBSCRIPTION_ID')

    RESOURCE_GROUP      = 'YOUR_RG'
    ACR_NAME            = 'YOUR_ACR_NAME'
    ACR_LOGIN_SERVER    = 'YOUR_ACR_NAME.azurecr.io'
    WEBAPP_NAME         = 'YOUR_WEBAPP_NAME'
    IMAGE_NAME          = 'bookstore'
  }

  triggers {
    // Jenkins will also be triggered via GitHub webhook; keep polling optional
    // pollSCM('H/5 * * * *')
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build') {
      steps { sh 'mvn -B -DskipTests clean package' }
    }

    stage('Test') {
      steps { sh 'mvn -B test' }
      post { always { junit 'target/surefire-reports/*.xml' } }
    }

    stage('Docker Build') {
      steps {
        sh """
          docker build -t ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${BUILD_NUMBER} .
          docker tag ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${BUILD_NUMBER} ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest
        """
      }
    }

    stage('Azure Login + Push to ACR') {
      steps {
        sh """
          az login --service-principal -u ${AZ_CLIENT_ID} -p ${AZ_CLIENT_SECRET} --tenant ${AZ_TENANT_ID}
          az account set --subscription ${AZ_SUBSCRIPTION_ID}

          az acr login -n ${ACR_NAME}

          docker push ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${BUILD_NUMBER}
          docker push ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest
        """
      }
    }

    stage('Deploy Container to Azure Web App') {
      steps {
        sh """
          az webapp config appsettings set -g ${RESOURCE_GROUP} -n ${WEBAPP_NAME} --settings WEBSITES_PORT=8081

          az webapp config container set \
            -g ${RESOURCE_GROUP} \
            -n ${WEBAPP_NAME} \
            --docker-custom-image-name ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest \
            --docker-registry-server-url https://${ACR_LOGIN_SERVER}

          az webapp restart -g ${RESOURCE_GROUP} -n ${WEBAPP_NAME}
        """
      }
    }
  }
}
